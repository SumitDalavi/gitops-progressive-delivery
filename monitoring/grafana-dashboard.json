{
  "title": "GitOps Progressive Delivery",
  "uid": "gitops-canary",
  "tags": ["gitops", "canary", "argo-rollouts"],
  "panels": [
    {
      "id": 1,
      "title": "Canary vs Stable Traffic Weight",
      "type": "gauge",
      "targets": [{
        "expr": "argo_rollout_info{name=~'.*',namespace='demo'}",
        "legendFormat": "{{name}} - {{phase}}"
      }],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
    },
    {
      "id": 2,
      "title": "HTTP Success Rate by Version",
      "type": "timeseries",
      "targets": [{
        "expr": "sum(rate(http_requests_total{namespace='demo', status!~'5..'}[2m])) by (service) / sum(rate(http_requests_total{namespace='demo'}[2m])) by (service)",
        "legendFormat": "{{service}}"
      }],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "fieldConfig": {
        "defaults": { "min": 0, "max": 1, "unit": "percentunit",
                      "thresholds": {"steps": [{"color": "red", "value": 0}, {"color": "green", "value": 0.99}]} }
      }
    },
    {
      "id": 3,
      "title": "P99 Latency (ms)",
      "type": "timeseries",
      "targets": [{
        "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_milliseconds_bucket{namespace='demo'}[2m])) by (le, service))",
        "legendFormat": "{{service}} p99"
      }],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}
    },
    {
      "id": 4,
      "title": "Rollout Phase",
      "type": "stat",
      "targets": [{
        "expr": "argo_rollout_phase{namespace='demo'}",
        "legendFormat": "{{name}}"
      }],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}
    }
  ]
}
